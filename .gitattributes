# .cmd files are GBK-encoded with CRLF line endings.
# They must be stored byte-for-byte, otherwise Chinese text breaks and
# batch labels (goto) stop working. "-text" disables all conversion.
*.cmd -text

# PowerShell and Markdown are text; force CRLF in working tree for PS1.
*.ps1 text eol=crlf
*.md text eol=lf
LICENSE text eol=lf